# use the python version
FROM python:3.12-slim

# keep python output visible in the docker
ENV PYTHONNUNBUFFLERED=1
ENV PYTHONDONTWRITECODE=1

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY src/ ./src/

# Copy the trained model that the API loads.
COPY artifacts/churn_pipeline.joblib ./artifacts/churn_pipeline.joblib

# Make the API port available.
EXPOSE 8000

# Start the FastAPI app when the container runs.
CMD ["uvicorn", "src.app.main:app", "--host", "0.0.0.0", "--port", "8000"]

